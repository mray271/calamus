# Pre-baked CI image for Fedora 44.
# Used by compat.yml (distro-matrix) and selinux.yml (selinux-fedora-container).
# Rebuilt only when this file or .github/workflows/ci-images.yml changes.
FROM fedora:44

RUN dnf install -y \
    python3 python3-gobject python3-cairo \
    gtk4 libadwaita gtksourceview5 \
    gobject-introspection gcc \
    xorg-x11-server-Xvfb dbus-daemon dbus-tools \
    curl git \
    cairo-devel cairo-gobject-devel gobject-introspection-devel python3-devel pkg-config \
    policycoreutils python3-libselinux \
    && dnf clean all

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
